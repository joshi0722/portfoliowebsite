<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>3D Portfolio</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      color: #f8fafc;
      background: #050816;
    }

    /* The 3D canvas stays fixed behind all content */
    #bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
    }

    section {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 8vw;
    }

    .right { align-items: flex-end; text-align: right; }

    h1 {
      font-size: clamp(2.5rem, 7vw, 5rem);
      margin: 0 0 10px;
    }

    h1 span { color: #a78bfa; }

    h2 { font-size: clamp(1.8rem, 4vw, 3rem); margin: 0 0 10px; }

    p {
      max-width: 480px;
      font-size: 1.1rem;
      line-height: 1.6;
      color: #cbd5e1;
    }

    .card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(167, 139, 250, 0.3);
      border-radius: 16px;
      padding: 24px 28px;
      max-width: 520px;
    }

    .btn {
      display: inline-block;
      margin-top: 16px;
      padding: 12px 26px;
      border-radius: 999px;
      background: #7c3aed;
      color: white;
      text-decoration: none;
      font-weight: 600;
    }

    /* Skills tags glow to match the neon space aesthetic */
    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
      max-width: 480px;
    }

    .skill-tag {
      padding: 10px 16px;
      border-radius: 999px;
      background: rgba(124, 58, 237, 0.18);
      border: 1px solid rgba(96, 165, 250, 0.8);
      box-shadow: 0 0 10px rgba(96, 165, 250, 0.7), 0 0 20px rgba(168, 85, 247, 0.5);
      color: #e0f2fe;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .hint {
      position: fixed;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.85rem;
      color: #94a3b8;
    }
  </style>
</head>
<body>
  <canvas id="bg"></canvas>

  <section>
    <h1>Hi, I'm <span>Joshi</span></h1>
    <p>CSE student building websites, games and AI projects. Move your mouse and scroll to explore.</p>
    <a class="btn" href="#projects">See my work</a>
  </section>

  <section class="right">
    <div class="card">
      <h2>About Me</h2>
      <p>I love turning ideas into interactive experiences using HTML, CSS, JavaScript and 3D graphics.</p>
    </div>
  </section>

  <section id="skills">
    <div class="card">
      <h2>Skills</h2>
      <div class="skills-list">
        <span class="skill-tag">C</span>
        <span class="skill-tag">HTML</span>
        <span class="skill-tag">CSS</span>
        <span class="skill-tag">JavaScript</span>
        <span class="skill-tag">Three.js</span>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="card">
      <h2>Projects</h2>
      <p>Food menu website, HackFest event site, C Code Lab learning app, and this 3D portfolio.</p>
    </div>
  </section>

  <div class="hint">Move the mouse · Scroll down</div>

  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js"
      }
    }
  </script>

  <script type="module">
    import * as THREE from "three";

    // Scene, camera, renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 30;

    const renderer = new THREE.WebGLRenderer({
      canvas: document.querySelector("#bg"),
      antialias: true,
      alpha: true
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    // Replace the purple torus knot with a glowing wireframe sphere that pulses for a gentler neon effect.
    const glowSphere = new THREE.Mesh(
      new THREE.SphereGeometry(7.5, 32, 32),
      new THREE.MeshBasicMaterial({
        color: 0xa78bfa,
        wireframe: true,
        transparent: true,
        opacity: 0.95
      })
    );
    glowSphere.position.x = 12;
    scene.add(glowSphere);

    // Add a soft outer glow so the sphere feels more illuminated and futuristic.
    const glowHalo = new THREE.Mesh(
      new THREE.SphereGeometry(9, 32, 32),
      new THREE.MeshBasicMaterial({
        color: 0x60a5fa,
        wireframe: true,
        transparent: true,
        opacity: 0.12
      })
    );
    glowHalo.position.x = 12;
    scene.add(glowHalo);

    // Lights
    const ambient = new THREE.AmbientLight(0xffffff, 0.4);
    const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
    keyLight.position.set(10, 20, 15);
    const pinkLight = new THREE.DirectionalLight(0xec4899, 1.5);
    pinkLight.position.set(-20, -10, 5);
    scene.add(ambient, keyLight, pinkLight);

    // Stars: 1500 tiny points placed randomly
    const starCount = 1500;
    const positions = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount * 3; i++) {
      positions[i] = (Math.random() - 0.5) * 300;
    }
    const starGeometry = new THREE.BufferGeometry();
    starGeometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    const stars = new THREE.Points(
      starGeometry,
      new THREE.PointsMaterial({ color: 0xffffff, size: 0.35 })
    );
    scene.add(stars);

    // Floating cubes made with a loop
    const cubes = [];
    const cubeColors = [0x22d3ee, 0xf472b6, 0xfacc15, 0x34d399, 0x60a5fa, 0xf9a8d4];
    for (let i = 0; i < 12; i++) {
      const cube = new THREE.Mesh(
        new THREE.BoxGeometry(1.5, 1.5, 1.5),
        new THREE.MeshStandardMaterial({ color: cubeColors[i % cubeColors.length] })
      );
      cube.position.set(
        (Math.random() - 0.5) * 60,
        (Math.random() - 0.5) * 40,
        (Math.random() - 0.5) * 30 - 10
      );
      scene.add(cube);
      cubes.push(cube);
    }

    // Mouse movement tilts the main object
    const mouse = { x: 0, y: 0 };
    window.addEventListener("mousemove", (event) => {
      mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
      mouse.y = (event.clientY / window.innerHeight) * 2 - 1;
    });

    // Scrolling moves the camera
    let scrollY = 0;
    window.addEventListener("scroll", () => {
      scrollY = window.scrollY;
    });

    // Clicking anywhere cycles the cube palette so the floating objects respond to user interaction.
    let colorIndex = 0;
    const clickColors = [0x22d3ee, 0xf472b6, 0xfacc15, 0x34d399, 0x60a5fa, 0xc084fc];
    window.addEventListener("click", () => {
      colorIndex = (colorIndex + 1) % clickColors.length;
      cubes.forEach((cube, idx) => {
        cube.material.color.setHex(clickColors[(colorIndex + idx) % clickColors.length]);
      });
    });

    // Animation loop
    const clock = new THREE.Clock();
    function animate() {
      const time = clock.getElapsedTime();

      const pulse = 1 + Math.sin(time * 1.8) * 0.18;
      glowSphere.scale.setScalar(pulse);
      glowHalo.scale.setScalar(1 + Math.sin(time * 1.6) * 0.2);
      glowSphere.rotation.x = time * 0.3 + mouse.y * 0.5;
      glowSphere.rotation.y = time * 0.4 + mouse.x * 0.5;
      glowHalo.rotation.x = -time * 0.25;
      glowHalo.rotation.y = time * 0.35;

      cubes.forEach((cube, i) => {
        cube.rotation.x += 0.01;
        cube.rotation.y += 0.015;
        cube.position.y += Math.sin(time + i) * 0.01;
      });

      stars.rotation.y = time * 0.02;

      camera.position.z = 30 + scrollY * 0.01;
      camera.position.y = -scrollY * 0.005;

      renderer.render(scene, camera);
    }
    renderer.setAnimationLoop(animate);

    // Resize
    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
